
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="KIDAR SPORTS - Actualités et résultats sportifs">
  <title>KIDAR SPORTS | Actualités sportives</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0b1220;
      color: white;
    }

    header {
      background: #101c30;
      padding: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
      color: #19e68c;
    }

    nav {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    nav a:hover {
      color: #19e68c;
    }

    .hero {
      text-align: center;
      padding: 75px 20px;
      background: linear-gradient(135deg, #123c54, #101c30);
    }

    .hero h1 {
      font-size: 38px;
      margin-bottom: 15px;
    }

    .hero p {
      color: #c4d2df;
      font-size: 17px;
    }

    .container {
      max-width: 1000px;
      margin: auto;
      padding: 30px 18px;
    }

    .section-title {
      color: #19e68c;
      margin-bottom: 20px;
      font-size: 25px;
    }

    .matches {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 15px;
    }

    .card {
      background: #17253a;
      border-radius: 12px;
      padding: 22px;
      text-align: center;
      border: 1px solid #263951;
    }

    .league {
      color: #9aacc0;
      font-size: 13px;
      margin-bottom: 15px;
    }

    .teams {
      font-size: 17px;
      font-weight: bold;
    }

    .score {
      font-size: 30px;
      color: #19e68c;
      margin: 15px;
    }

    .news {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 15px;
    }

    .news h3 {
      margin-bottom: 12px;
    }

    .news p {
      color: #bdc9d6;
      line-height: 1.5;
    }

    footer {
      background: #101c30;
      text-align: center;
      padding: 25px;
      color: #aab8c8;
      margin-top: 30px;
    }

    @media(max-width: 500px) {
      .hero h1 {
        font-size: 29px;
      }

      header {
        justify-content: center;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">⚽ KIDAR SPORTS</div>

    <nav>
      <a href="#accueil">Accueil</a>
      <a href="#matchs">Matchs</a>
      <a href="#actualites">Actualités</a>
    </nav>
  </header>

  <section class="hero" id="accueil">
    <h1>LE SPORT EN UN CLIC</h1>
    <p>Suivez le monde du sport avec KIDAR SPORTS.</p>
  </section>

  <main class="container">

    <section id="matchs">
      <h2 class="section-title">🏆 Résultats sportifs</h2>

      <div class="matches">

        <div class="card">
          <p class="league">Exemple de match</p>
          <p class="teams">Real Madrid - Barcelona</p>
          <div class="score">2 - 1</div>
          <p>Résultat fictif</p>
        </div>

        <div class="card">
          <p class="league">Exemple de match</p>
          <p class="teams">Arsenal - Liverpool</p>
          <div class="score">1 - 1</div>
          <p>Résultat fictif</p>
        </div>

      </div>
    </section>

    <section id="actualites" style="margin-top:40px">
      <h2 class="section-title">📰 Actualités sportives</h2>

      <div class="news">

        <article class="card">
          <h3>⚽ Football</h3>
          <p>Retrouvez les nouvelles du football international.</p>
        </article>

        <article class="card">
          <h3>🏀 Basketball</h3>
          <p>Suivez les grandes compétitions de basketball.</p>
        </article>

        <article class="card">
          <h3>🎾 Tennis</h3>
          <p>Découvrez les événements du tennis mondial.</p>
        </article>

      </div>
    </section>

  </main>

  <footer>
    <p>© 2026 KIDAR SPORTS</p>
    <p>Le sport rassemble le monde.</p>
  </footer>

</body>
</html>
